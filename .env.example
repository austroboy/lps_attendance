DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Asia/Dhaka

# sqlite (default) or postgres
DB_ENGINE=sqlite
# DB_NAME=lps_attendance
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

EBKN_ENDPOINT_PATH=/ebkn/
EBKN_AUTO_DISCOVER=True
EBKN_TRAFFIC_LOG=True

SSLWIRELESS_BASE_URL=https://smsplus.sslwireless.com
SSLWIRELESS_API_TOKEN=
SSLWIRELESS_SID=
EBKN_LOG_LEVEL=INFO

# Celery / background imports
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Set to True only if you have no Redis; imports then run inside the request.
CELERY_TASK_ALWAYS_EAGER=False
